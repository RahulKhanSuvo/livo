model RoomHotspot {
  id           String   @id @default(cuid())
  x            Float
  y            Float
  cardPosition String? // 'top' | 'bottom' | 'left' | 'right'
  productId    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RoomScene {
  id        String   @id @default("global")
  imageUrl  String
  updatedAt DateTime @updatedAt
}

model ProductSliderItem {
  id        String   @id @default(cuid())
  productId String
  mediaUrl  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}
