model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  image         String?
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productTypes ProductType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProductType {
  id            String      @id @default(cuid())
  name          String
  slug          String      @unique
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  products      Product[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  image       String?
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Material {
  id          String    @id @default(cuid())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

enum ProductStatus {
  ACTIVE
  DEACTIVATED
}

model Product {
  id               String           @id @default(cuid())
  productTypeId    String
  productType      ProductType      @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  name             String
  description      String
  width            Float
  height           Float
  depth            Float
  status           ProductStatus    @default(ACTIVE)
  weightKg         Float
  price            Float
  salePrice        Float            @default(0)
  soldCount        Int              @default(0)
  assemblyRequired Boolean          @default(false)
  variants         ProductVariant[]
  badges           ProductBadge[]
  orderItems       OrderItem[]
  brand            Brand?           @relation(fields: [brandId], references: [id])
  brandId          String?
  material         Material?        @relation(fields: [materialId], references: [id])
  materialId       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cartItems        CartItem[]
  reviews          Review[]

  @@index([productTypeId])
  @@index([status])
  @@index([name])
  @@index([createdAt])
  @@index([price])
  @@index([soldCount])
}

model ProductVariant {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorHex   String?
  stock      Int
  images     ProductImage[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orderItems OrderItem[]

  @@index([productId])
  @@index([productId, stock])
}

model ProductImage {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  imageUrl  String
  alt       String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
}

model ProductBadge {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  type      BadgeType

  createdAt DateTime @default(now())
}

enum BadgeType {
  SALE
  TRENDING
}
